# ============================================================================
# DevScout environment. Copy to `.env` and fill in. Everything marked OPTIONAL
# has a working local fallback, so the app boots and demos with only the two
# REQUIRED values set.
# ============================================================================

# --- REQUIRED -------------------------------------------------------------
# Postgres 14+ with the `vector` extension available (docker compose provides it).
DATABASE_URL=
# Signs session JWTs. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Core ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Redis (OPTIONAL) ------------------------------------------------------
# Backs the cache, the sliding-window rate limiter and the ingestion queue.
# Unset -> an in-process implementation with the same interface is used, which
# is correct for a single instance but does not coordinate across replicas.
# Upstash/Redis Cloud TLS URLs (rediss://) work as-is.
REDIS_URL=redis://localhost:6379

# --- GitHub (OPTIONAL) -----------------------------------------------------
# Unauthenticated GitHub allows 60 req/hr; a token raises it to 5000/hr and is
# effectively required to ingest a real corpus. Needs no scopes for public data.
GITHUB_TOKEN=

# --- Embeddings (OPTIONAL) -------------------------------------------------
# Unset -> DevScout uses its built-in deterministic hashed-feature embedder.
# Both paths produce 256-dim vectors; the active model is recorded per row so
# vectors from different models are never compared against each other.
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=

# --- LLM summaries (OPTIONAL) ----------------------------------------------
# Unset -> deterministic rule-based summaries derived from the same evidence.
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-3.5-haiku

# --- Stripe (OPTIONAL) -----------------------------------------------------
# Unset -> billing routes return 503 and every org stays on the Free plan.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_SCALE=
TRIAL_DAYS=14

# --- Workers / cron --------------------------------------------------------
# Shared secret for POST /api/cron/* so only your scheduler can drain the queue.
CRON_SECRET=
WORKER_CONCURRENCY=4

# --- Demo ------------------------------------------------------------------
# Credentials created by `npm run seed`. Shown on the sign-in page when true.
DEMO_MODE=true

# Gemini summaries; server only. Never expose this as a VITE_ variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Direct Neon endpoint for migration advisory locks (no -pooler).
DIRECT_DATABASE_URL=
