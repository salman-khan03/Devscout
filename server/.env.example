# DevScout server configuration.
#
# Only DATABASE_URL and JWT_SECRET are required. Every other variable either has
# a working default or switches on an optional capability - the app reports which
# ones are active at boot and on /api/ingest/status.

# --- Core ---
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- Required ---
# Credentials match docker-compose.yml. If you use your own Postgres, the
# database needs the pgvector extension available.
DATABASE_URL=

# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters; the server refuses to boot otherwise.
JWT_SECRET=

# --- Redis (optional) ---
# Carries the rate limiter, the cache, and a wake-up signal that lets a newly
# enqueued job start immediately instead of waiting out the worker poll.
# The job queue itself lives in Postgres, so nothing is lost without Redis -
# the limiter and cache just fall back to in-process versions, which are correct
# for a single instance but not shared between processes.
REDIS_URL=redis://localhost:6379

# --- GitHub (optional) ---
# Unset: the app serves only the indexed corpus, and `npm run seed` generates
# synthetic profiles labelled as demo data throughout the UI.
# Set: live profile ingestion and discovery, at 5,000 requests/hour.
GITHUB_TOKEN=

# --- Embeddings ---
# 'local' is a deterministic hashed embedder with no network calls - the default
# so the project runs offline. 'openai' requires OPENAI_API_KEY and uses
# text-embedding-3-small at 256 dimensions.
# Changing this invalidates existing vectors: re-embed the corpus afterwards.
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=

# --- Candidate summaries (optional) ---
# Unset: summaries and role-fit lines come from a signal-based heuristic, and
# the UI says so on every profile. Set: generated by the model below.
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-3.5-haiku

# --- Stripe (optional; billing is hidden entirely when unset) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_SCALE=
TRIAL_DAYS=14

# --- Operations ---
# Shared secret for the /api/cron/* endpoints, so a scheduler can drain the
# queue without a user session.
CRON_SECRET=
WORKER_CONCURRENCY=4

# Labels synthetic corpus rows as demo data in the UI. Turn it off only once
# the corpus is real.
DEMO_MODE=true

# Gemini summaries; server only. Never expose this as a VITE_ variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Direct Neon endpoint for migration advisory locks (no -pooler).
DIRECT_DATABASE_URL=
